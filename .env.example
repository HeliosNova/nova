# Nova Configuration
# Copy to .env and customize. All values shown are the config.py defaults
# (regenerated 2026-08-25 — the previous template shipped ~16 stale values
# that silently DOWNGRADED a fresh install, e.g. MAX_KG_FACTS=1000 re-created
# the exact candidate-window truncation bug fixed on 2026-05-30).

# --- LLM Provider (Ollama only — cloud providers removed in v1.5.0) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:27b
# Production example: LLM_MODEL=nova-ft (the 9B fine-tune tag in Ollama)
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
# bge-m3 won a 2026 paraphrase-retrieval bake-off (see app/core/embedding.py;
# re-confirmed vs qwen3-embedding on the live KG 2026-08-24). Set to "default"
# to use ChromaDB's bundled all-MiniLM-L6-v2 (zero GPU/network, lower recall).
# Dedicated CPU embed instance (compose service `embed`); falls back to
# OLLAMA_URL if unreachable.
EMBED_OLLAMA_URL=http://embed:11434
# 27B used for monitor digest synthesis (production: qwen3.8:27b via
# /data/config_overrides.json since 2026-08-16). Empty = LLM_MODEL.
MONITOR_SYNTHESIS_MODEL=

# --- MCP (Model Context Protocol) ---
ENABLE_MCP=true
MCP_CONFIG_DIR=/data/mcp
ENABLE_MCP_SERVER=true
MCP_SERVER_NAME=nova

# --- Search ---
SEARXNG_URL=http://searxng:8080

# --- Security ---
SYSTEM_ACCESS_LEVEL=sandboxed
# Auth: the compose file binds all ports to 127.0.0.1 (localhost only), so out of
# the box Nova runs key-less for the single local user. BEFORE exposing Nova to a
# network (changing the 127.0.0.1 bindings or putting it behind a reverse proxy),
# set NOVA_API_KEY to a long random string AND REQUIRE_AUTH=true — otherwise your
# instance is publicly accessible. With REQUIRE_AUTH=true and an empty key, every
# request returns 503 "API key not configured" (a deliberate fail-closed guard).
NOVA_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_INJECTION_DETECTION=true
REQUIRE_SIGNED_SKILLS=true
REQUIRE_AUTH=false
TRUSTED_PROXY=
AUTH_MAX_FAILURES=10
AUTH_LOCKOUT_SECONDS=300
AUTH_MAX_TRACKED_IPS=10000

# --- Tool Timeouts ---
TOOL_TIMEOUT=180
GENERATION_TIMEOUT=900
INTERNAL_LLM_TIMEOUT=60
CODE_EXEC_TIMEOUT=15
SHELL_EXEC_TIMEOUT=45
BROWSER_TIMEOUT=60
BROWSER_CDP_URL=
MAX_TOOL_ROUNDS=6
TOOL_OUTPUT_MAX_CHARS=10000
ENABLE_SHELL_EXEC=false

# --- Context & Memory ---
MAX_CONTEXT_TOKENS=21000
RECENT_MESSAGES_KEEP=12
MAX_SYSTEM_TOKENS=13500
MAX_HISTORY_MESSAGES=50
MAX_LESSONS_IN_PROMPT=5
MAX_SKILLS_CHECK=500

# --- Retrieval ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RRF_K=60

# --- Limits ---
MAX_USER_FACTS=30
# Candidate cap for KG relevance scoring. MUST stay >= the live-fact count —
# an undersized cap silently truncates the candidate window (2026-05-30 bug).
MAX_KG_FACTS=5000
MAX_KG_FACTS_IN_PROMPT=20
MAX_REFLEXIONS=200
MAX_REFLEXIONS_IN_PROMPT=3
MAX_SUCCESS_PATTERNS_IN_PROMPT=2
MAX_LESSONS=500
MAX_CURIOSITY_PENDING=50
MAX_CURIOSITY_ATTEMPTS=3
MAX_CUSTOM_TOOL_CODE_LENGTH=5000
MAX_CUSTOM_TOOLS=50
RATE_LIMIT_RPM=60
MAX_QUERY_LENGTH=50000

# --- Critique ---
MAX_CRITIQUE_ROUNDS=3
CRITIQUE_ANSWER_LIMIT=1500
CRITIQUE_SOURCES_LIMIT=1500
CRITIQUE_FACTS_LIMIT=2000

# --- Reasoning ---
ENABLE_PLANNING=true
ENABLE_CRITIQUE=true
ENABLE_CUSTOM_TOOLS=true
# NOTE (2026-08-24 selective thinking): even with this false, hard-reasoning
# GENERAL-intent queries auto-enable thinking via the brain.py gate (channel
# "monitor" excluded). false = no blanket thinking, not "never thinks".
ENABLE_EXTENDED_THINKING=true
# AgentLoop deliberation route (plan→act→critique→synthesize) for
# design/walkthrough queries. Own flag since 2026-08-25.
ENABLE_DELIBERATION=true

# --- Entailment gate (MiniCheck sidecar) ---
# Production runs true since 2026-08: digest claims must be ENTAILED by
# their cited source or they are rescued/dropped (the anti-fabrication gate).
ENABLE_MINICHECK=false
MINICHECK_URL=http://minicheck:8080

# --- Two-Phase Dream Consolidation ---
# SCM/SleepGate-style split (arxiv 2604.20943 + 2603.14517). Dream Phase 3
# splits into NREM (structural / deterministic substeps: prune, compact,
# disable; ~5s) and REM (integrative / LLM substeps: promote, resolve,
# generalize; ~60s). REM failures no longer roll back NREM. Off by default
# while we measure the actual time split in your environment.
ENABLE_TWO_PHASE_DREAM=false
DREAM_REM_TIMEOUT_SECONDS=60

# --- Model Routing ---
VISION_MODEL=qwen3.5:9b
FAST_MODEL=qwen3.5:4b
HEAVY_MODEL=
ENABLE_MODEL_ROUTING=true
# Independent judge for quality grading (reflexion critique + monitor output
# eval). Use a DIFFERENT model family from LLM_MODEL so the system never
# grades its own homework — production uses gemma4:e4b (`ollama pull
# gemma4:e4b`). Do NOT use gemma3:4b: the 2026-08 A/B showed it silently
# floored 75% of grades (1/4 schema-valid). Empty = legacy self-critique.
JUDGE_MODEL=

# --- Backups ---
# Off-volume snapshot target inside the container (compose bind-mounts
# ./backups here). Daily snapshots are integrity-verified on creation and
# copied off-volume so they survive loss of the nova_data volume.
# Verify any snapshot before restoring: python -m app.core.backup <file>
BACKUP_OFFVOLUME_DIR=/backups

# --- Delegation ---
ENABLE_DELEGATION=true
MAX_DELEGATION_DEPTH=1

# --- Background Tasks ---
MAX_BACKGROUND_TASKS=5
BACKGROUND_TASK_TIMEOUT=300

# --- Tuning Parameters ---
RESPONSE_TOKEN_BUDGET=4000
RETRIEVAL_RELEVANCE_THRESHOLD=0.15
TEMPERATURE_DEFAULT=0.7
# Relevance floor for fused lesson retrieval. 0.005 keeps single-source hits
# alive (the old 0.015 silently vetoed them). Strong vector matches (below
# LESSON_VECTOR_STRONG_DISTANCE) bypass this floor entirely.
MIN_RRF_SCORE=0.005
LESSON_VECTOR_MAX_DISTANCE=0.9
LESSON_VECTOR_STRONG_DISTANCE=0.55
DEDUP_JACCARD_THRESHOLD=0.85
REFLEXION_DECAY_DAYS=90
REFLEXION_DECAY_AMOUNT=0.05
SKILL_EMA_ALPHA=0.15
INJECTION_SUSPICIOUS_THRESHOLD=0.3
REFLEXION_FAILURE_THRESHOLD=0.6
REFLEXION_SUCCESS_THRESHOLD=0.8
KG_GRAPH_MAX_FRONTIER=1000

# --- Learning ---
TRAINING_DATA_PATH=/data/training_data.jsonl
TRAINING_DATA_CHANNELS=api
MAX_TRAINING_PAIRS=10000

# --- Skills ---
ENABLE_AUTO_SKILL_CREATION=true
SKILLS_DIR=/data/skills

# --- Curiosity ---
ENABLE_CURIOSITY=true

# --- Heartbeat / Proactive ---
ENABLE_HEARTBEAT=true
HEARTBEAT_INTERVAL=60
ENABLE_PROACTIVE=true
DIGEST_HOUR=21

# --- Desktop Automation ---
ENABLE_DESKTOP_AUTOMATION=false
DESKTOP_CLICK_DELAY=0.5
SCREENSHOT_DIR=/tmp/nova_screenshots

# --- Voice ---
ENABLE_VOICE=false
WHISPER_MODEL_SIZE=base
VOICE_MAX_DURATION=300

# --- Email ---
ENABLE_EMAIL_SEND=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_SMTP_TLS=true
EMAIL_ALLOWED_RECIPIENTS=

# --- Calendar ---
ENABLE_CALENDAR=true
CALENDAR_PATH=/data/calendar.ics

# --- Webhooks ---
ENABLE_WEBHOOKS=false
WEBHOOK_ALLOWED_URLS=

# --- Integrations ---
ENABLE_INTEGRATIONS=true

# --- Channels (leave token empty to disable) ---
# ALLOWED_USERS lists are FAIL-CLOSED: if a channel is enabled but its
# allowlist is empty, ALL users are denied. You must list your own ID/number.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USERS=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# WhatsApp (Business API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_CHAT_ID=
WHATSAPP_ALLOWED_USERS=
WHATSAPP_APP_SECRET=

# Signal (signal-cli REST API)
SIGNAL_API_URL=
SIGNAL_PHONE_NUMBER=
SIGNAL_CHAT_ID=
SIGNAL_ALLOWED_USERS=
SIGNAL_POLL_INTERVAL=2

# --- Fine-tuning ---
# Threshold for the Fine-Tune Check monitor to notify "ready". Set 2026-05-14
# (task #23) to 100 — matches the monthly-cadence policy at ~3.3 pairs/day
# organic accumulation. Lower values triggered notifies before the new-data
# delta was big enough to A/B-differentiate (the #41 smoke on 19 pairs A/B'd
# 10/10 ties).
FINETUNE_MIN_NEW_PAIRS=100
FINETUNE_OUTPUT_DIR=/data/finetune

# --- Database ---
DB_PATH=/data/nova.db
CHROMADB_PATH=/data/chromadb

# --- Server ---
PORT=8000
